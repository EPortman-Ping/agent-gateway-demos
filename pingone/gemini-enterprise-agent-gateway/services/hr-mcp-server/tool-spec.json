{
  "tools": [
    {
      "name": "list_employees",
      "description": "List all employees in the directory. Returns each employee's name, email, and username.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "employees": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "given_name": { "type": "string" },
                "family_name": { "type": "string" },
                "email": { "type": "string" },
                "username": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_employee",
      "description": "Get details for a specific employee by their email address or PingOne user ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email_or_id": {
            "type": "string",
            "description": "The employee's email address (e.g. alice@example.com) or PingOne user ID."
          }
        },
        "required": ["email_or_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "given_name": { "type": "string" },
          "family_name": { "type": "string" },
          "email": { "type": "string" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_employee",
      "description": "Create a new employee in the directory. Requires HR admin access — requests from non-admin users are denied at the gateway before reaching this tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "given_name": {
            "type": "string",
            "description": "The employee's first name."
          },
          "family_name": {
            "type": "string",
            "description": "The employee's last name."
          },
          "email": {
            "type": "string",
            "description": "The employee's work email address."
          },
          "username": {
            "type": "string",
            "description": "The employee's username (typically the same as their email)."
          }
        },
        "required": ["given_name", "family_name", "email", "username"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "given_name": { "type": "string" },
          "family_name": { "type": "string" },
          "email": { "type": "string" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  ]
}
