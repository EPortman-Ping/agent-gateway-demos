GC_CLOUD_RUN_SERVICE_NAME=ge-hr-mcp-server
GC_REGION=us-central1
IDP_ISSUER=https://auth.pingone.com/<env-id>/as
IDP_REQUIRED_SCOPE=hr_mcp:read
IDP_REQUIRED_AUDIENCE=hr-mcp-server
# Worker app with Identity Data Admin role (required for create_employee)
PINGONE_MGMT_CLIENT_ID=<management-worker-client-id>
PINGONE_MGMT_CLIENT_SECRET=<management-worker-client-secret>
