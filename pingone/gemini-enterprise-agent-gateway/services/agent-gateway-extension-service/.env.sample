GC_CLOUD_RUN_SERVICE_NAME=ge-agent-gateway-extension-service
GC_REGION=us-central1
IDP_TOKEN_ENDPOINT=https://auth.pingone.com/<env-id>/as/token
IDP_CLIENT_ID=<extension-service-client-id>
IDP_CLIENT_SECRET=<extension-service-client-secret>
IDP_SCOPE=hr_mcp:read
IDP_REQUIRED_AUDIENCE=hr-mcp-server
TOOL_URL=https://<hr-mcp-server-cloud-run-url>
AUTHZ_DECISION_ENDPOINT=https://api.pingone.com/v1/environments/<env-id>/decisionEndpoints/<endpoint-id>
AUTHZ_CLIENT_ID=<authorize-worker-client-id>
AUTHZ_CLIENT_SECRET=<authorize-worker-client-secret>
