GC_REGION=us-central1
GC_CLOUD_RUN_SERVICE_NAME=ac-agent-gateway-extension-service

IDP_TOKEN_ENDPOINT=https://auth.pingone.<region>/<environment-id>/as/token
IDP_CLIENT_ID=replace-me
IDP_CLIENT_SECRET=replace-me

# Native Order Status Agent A2A endpoint. Populate after deploying the Order Status Agent.
A2A_TARGET_URL=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/<project-number>/locations/us-central1/reasoningEngines/<engine-id>/a2a
A2A_REQUIRED_AUDIENCE=order-status-agent
A2A_REQUIRED_SCOPE=order-status:invoke
# Temporary plumbing mode: audience/scope validation is active; actor checks are disabled.
# In this mode the A2A delegation is forwarded unchanged; only the MCP hop is exchanged.
AUTHZ_MODE=permit-all

MCP_TARGET_URL=https://ac-order-status-mcp-server-f447x3emfq-uc.a.run.app/mcp
MCP_REQUIRED_AUDIENCE=order-status-mcp-server
MCP_REQUIRED_SCOPE=order:read

# Only required when AUTHZ_MODE is changed from permit-all.
AUTHZ_DECISION_ENDPOINT=https://api.pingone.<region>/v1/environments/<environment-id>/decisionEndpoints/<agent-chain-policy-endpoint-id>
AUTHZ_CLIENT_ID=replace-me
AUTHZ_CLIENT_SECRET=replace-me
