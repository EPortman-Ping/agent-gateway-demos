{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Chaining order-status A2A request",
  "type": "object",
  "required": ["jsonrpc", "id", "method", "params"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "method": { "const": "message/send" },
    "params": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": {
          "type": "object",
          "required": ["messageId", "parts"],
          "properties": {
            "messageId": { "type": "string" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["kind", "text"],
                "properties": {
                  "kind": { "const": "text" },
                  "text": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
